<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="module_pos_glory_connector_category" model="ir.module.category">
        <field name="name">POS Glory Connector</field>
        <field name="sequence">99</field>
    </record>

    <record id="group_pos_glory_connector_category_manager" model="res.groups">
        <field name="name">Manager</field>
        <field
            name="category_id"
            ref="pos_glory_connector.module_pos_glory_connector_category"
        />
    </record>

    <record id="group_pos_glory_connector_category_manager_deletion" model="res.groups">
        <field name="name">Manager + Deletion</field>
        <field
            name="category_id"
            ref="pos_glory_connector.module_pos_glory_connector_category"
        />
        <field name="implied_ids" eval="[(4, ref('group_pos_glory_connector_category_manager'))]" />
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>

    <data noupdate="1">

        <record id="glory_transaction_company_rule" model="ir.rule">
            <field name="name">Glory Transaction Company Rule</field>
            <field name="model_id" ref="pos_glory_connector.model_glory_transaction" />
            <field name="domain_force">
                ['|',('company_id','=',False),('company_id','in',company_ids)]
            </field>
        </record>

        <record id="glory_transaction_report_company_rule" model="ir.rule">
            <field name="name">Glory Transaction Analysis Company Rule</field>
            <field
                name="model_id"
                ref="pos_glory_connector.model_glory_transaction_report"
            />
            <field name="domain_force">
                ['|',('company_id','=',False),('company_id','in',company_ids)]
            </field>
        </record>

    </data>

</odoo>
