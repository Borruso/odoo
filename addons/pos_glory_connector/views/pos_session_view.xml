<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="pos_session_form_view_inherit" model="ir.ui.view">
        <field name="name">pos.session.form.view.inherit</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <button
                    name="action_show_glory_transactions"
                    class="oe_stat_button"
                    icon="fa-bars"
                    type="object"
                    groups="pos_glory_connector.group_pos_glory_connector_category_manager"
                >
                    <field
                        name="glory_transaction_count"
                        widget="statinfo"
                        string="Glory Transactions"
                    />
                </button>
            </xpath>
        </field>
    </record>

</odoo>
