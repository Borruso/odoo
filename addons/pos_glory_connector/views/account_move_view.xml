<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="account_move_line_tree_view_inherit" model="ir.ui.view">
        <field name="name">account.move.line.tree.view.inherit</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree" />
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='partner_id']" position="after">
                <field name="employee_id" optional="hide" />
            </xpath>
        </field>
    </record>

    <record id="account_move_form_view_inherit" model="ir.ui.view">
        <field name="name">account.move.form.view.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='line_ids']/tree/field[@name='partner_id']"
                position="after"
            >
                <field name="employee_id" optional="hide" />
            </xpath>
        </field>
    </record>

</odoo>
