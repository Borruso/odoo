    <record id="mail_template_glory_transaction_state_cassette" model="mail.template">
        <field name="name">Glory Transaction: State Cassette</field>
        <field name="model_id" ref="pos_glory_connector.model_glory_transaction_mail" />
        <field name="subject">Check State Cassette</field>
        <field
            name="description"
        >Set this template to automate emails when state cassette is to be checked</field>
        <field name="body_html" type="html">
            <div>
                Dear PoS Manager,<br /><br />
                The machine <t
                    t-out="object.sudo().config_id.name or ''"
                >Roma (Via Piazza Trevi 98)</t>
                indicates that one or more recyclers are high or full.
                <br />
                State Cassette Coins: <t
                    t-out="object.sudo().state_cassette_coins or ''"
                >High</t>
                <br />
                State Cassette Bills: <t
                    t-out="object.sudo().state_cassette_bills or ''"
                >High</t>
                <br /> <br />
                <strong>Recyclers:</strong> <br />
                <table class="table table-sm" style="width: 50%">
                    <thead>
