<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-name="GloryOperationPopup" owl="1">
        <div class="modal-dialog">
            <div class="popup popup-text glory-popup-text">
                <h1>Glory Machine</h1>
                <p class="category">Operations</p>
                <div class="glory-popup-container">
                    <div
                        class="button glory-popup-button glory-popup-button-success dynamic-size"
                        t-on-click="openGloryOperationInventoryRequestPopup"
                        t-if="env.pos.config.enable_glory and env.pos.cashier.allow_inventory_operation"
                    >
                        <i class="fa fa-money" /> Inventory
                    </div>
                    <div
                        class="button glory-popup-button glory-popup-button-success dynamic-size"
                        t-on-click="openGloryOperationCassetteInventoryRequestPopup"
                        t-if="env.pos.config.enable_glory and env.pos.cashier.allow_inventory_operation"
                    >
                        <i class="fa fa-money" /> Inventory (Cassette)
                    </div>
                </div>
                <div class="glory-popup-container">
                    <div
                        class="button glory-popup-button glory-popup-button-success dynamic-size"
                        t-on-click="openGloryOperationStatusRequest"
                        t-if="env.pos.config.enable_glory and env.pos.cashier.allow_status_operation"
                    >
                        <i class="fa fa-cloud-download" /> Status
                    </div>
                </div>
                <div class="glory-popup-container">
                    <div
                        class="button glory-popup-button glory-popup-button-warning dynamic-size"
                        t-on-click="openGloryOperationExchange"
                        t-if="env.pos.config.enable_glory and env.pos.cashier.allow_exchange_operation"
                    >
                        <i class="fa fa-exchange" /> Exchange
                    </div>
                    <div
                        class="button glory-popup-button glory-popup-button-warning dynamic-size"
                        t-on-click="openGloryOperationAdministrator"
                        t-if="env.pos.config.enable_glory and env.pos.cashier.allow_administrator_operation"
                    >
                        <i class="fa fa-key" /> Administrator
                    </div>
                </div>
                <div class="glory-popup-container">
                    <div
                        class="button glory-popup-button glory-popup-button-danger dynamic-size"
                        t-on-click="openGloryOperationResetRequest"
                        t-if="env.pos.config.enable_glory and env.pos.cashier.allow_reset_operation"
                    >
                        <i class="fa fa-refresh" /> Reset
                    </div>
                    <div
                        class="button glory-popup-button glory-popup-button-danger dynamic-size"
                        t-on-click="openGloryOperationShutdownRequest"
                        t-if="env.pos.config.enable_glory and env.pos.cashier.allow_shutdown_operation"
                    >
                        <i class="fa fa-power-off" /> Shutdown
                    </div>
                    <div
                        class="button glory-popup-button glory-popup-button-danger dynamic-size"
                        t-on-click="openGloryOperationRebootRequest"
                        t-if="env.pos.config.enable_glory and env.pos.cashier.allow_reboot_operation"
                    >
                        <i class="fa fa-power-off" /> Reboot
                    </div>
                </div>
                <div class="footer">
                    <div
                        class="button glory-popup-button glory-popup-button-danger cancel"
                        t-on-click="cancel"
                    >
                        <i class="fa fa-close" /> Cancel
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
