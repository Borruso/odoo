        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//PaymentScreenPaymentLines" position="replace">
            <GloryPaymentScreenPaymentLines paymentLines="paymentLines" />
        </xpath>
    </t>

</templates>
